{
  "Comment": "SOAR Orchestrator - Stage 4 (최종): 로그확인(Agent)->위협판단->승인(HITL)->차단->완료알림, 에러 처리 포함",
  "StartAt": "CheckThreatLog",
  "States": {
    "CheckThreatLog": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CallAgentLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "verdict.$": "$.Payload"
      },
      "ResultPath": "$.agentResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "ThreatLevelChoice"
    },

    "ThreatLevelChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.agentResult.verdict.level",
          "StringEquals": "HIGH",
          "Next": "NotifyApprover"
        }
      ],
      "Default": "NoActionNeeded"
    },

    "NotifyApprover": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SnsApprovalTopicArn}",
        "Subject": "[SOAR] HIGH 위협 탐지 - 승인 필요",
        "Message.$": "States.Format('IP {} 가 위협도 HIGH(점수 {})로 판단되었습니다. requestId={}. 사유: {}\n승인: ./04_approval_processor/approve_cli.sh {} approve\n거부: ./04_approval_processor/approve_cli.sh {} reject', $.agentResult.verdict.ip, $.agentResult.verdict.score, $$.Execution.Name, $.agentResult.verdict.reason, $$.Execution.Name, $$.Execution.Name)"
      },
      "ResultPath": null,
      "Next": "WaitForApproval"
    },

    "WaitForApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${SqsApprovalQueueUrl}",
        "MessageBody": {
          "requestId.$": "$$.Execution.Name",
          "taskToken.$": "$$.Task.Token",
          "ip.$": "$.agentResult.verdict.ip",
          "score.$": "$.agentResult.verdict.score",
          "reason.$": "$.agentResult.verdict.reason"
        }
      },
      "TimeoutSeconds": 3600,
      "ResultPath": "$.approval",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "RecordRejected"
        }
      ],
      "Next": "ApprovalChoice"
    },

    "ApprovalChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approval.decision",
          "StringEquals": "APPROVE",
          "Next": "BlockIP"
        }
      ],
      "Default": "RecordRejected"
    },

    "BlockIP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${BlockIpLambdaArn}",
        "Payload": {
          "ip.$": "$.agentResult.verdict.ip",
          "requestId.$": "$$.Execution.Name",
          "reason.$": "$.agentResult.verdict.reason"
        }
      },
      "ResultSelector": {
        "blockResult.$": "$.Payload"
      },
      "ResultPath": "$.blockOutcome",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "NotifyCompletionApproved"
    },

    "NotifyCompletionApproved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SnsCompletionTopicArn}",
        "Subject": "[SOAR] 차단 완료",
        "Message.$": "States.Format('IP {} 가 승인 후 차단 목록에 등록되었습니다(모의 처리). requestId={}', $.agentResult.verdict.ip, $$.Execution.Name)"
      },
      "ResultPath": null,
      "End": true
    },

    "RecordRejected": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SnsCompletionTopicArn}",
        "Subject": "[SOAR] 차단 미승인/타임아웃",
        "Message.$": "States.Format('IP {} 에 대한 차단 요청이 거부되었거나 승인 대기 시간이 초과되었습니다. requestId={}', $.agentResult.verdict.ip, $$.Execution.Name)"
      },
      "ResultPath": null,
      "End": true
    },

    "NoActionNeeded": {
      "Type": "Pass",
      "Result": "위협도가 HIGH가 아니어서 별도 조치 없음",
      "End": true
    },

    "HandleError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SnsCompletionTopicArn}",
        "Subject": "[SOAR] 처리 중 오류 발생",
        "Message.$": "States.Format('SOAR 처리 중 오류가 발생했습니다. requestId={}, error={}', $$.Execution.Name, $.error)"
      },
      "ResultPath": null,
      "End": true
    }
  }
}
