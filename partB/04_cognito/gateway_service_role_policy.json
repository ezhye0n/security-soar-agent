{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowInvokeTargetLambdas",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:*:*:function:*checkIPReputation*",
        "arn:aws:lambda:*:*:function:*blockIP*"
      ]
    }
  ]
}
